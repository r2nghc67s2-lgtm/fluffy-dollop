<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>البث المباشر</title>

  <style>
    :root {
      color-scheme: dark;
      --bg: #07080b;
      --panel: #101116;
      --panel-deep: #090a0e;
      --border: #30323b;
      --text: #f1f1f5;
      --muted: #92949e;
      --gold: #f2bb55;
      --gold-light: #ffdc8a;
      --gold-dark: #b87d1b;
      --green: #5ed49a;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      min-height: 100vh;
      padding: 32px 18px;
      background:
        radial-gradient(ellipse at 50% -20%, #282116 0, transparent 43%),
        var(--bg);
      color: var(--text);
      font-family: Tahoma, Arial, sans-serif;
    }

    button, a { font: inherit; }

    .page {
      width: min(100%, 1040px);
      margin: 0 auto;
    }

    .header, .panel {
      border: 1px solid var(--border);
      border-radius: 32px;
      background: linear-gradient(145deg, #111218, #090a0e);
      box-shadow: 0 18px 55px #0005, inset 0 1px #ffffff08;
    }

    .header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      padding: 28px 32px;
      margin-bottom: 24px;
    }

    h1 {
      margin: 0 0 8px;
      font-size: clamp(25px, 4vw, 38px);
    }

    .subtitle, .hint {
      margin: 0;
      color: var(--muted);
      line-height: 1.8;
    }

    .status {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      flex: 0 0 auto;
      padding: 12px 16px;
      border: 1px solid #34363e;
      border-radius: 999px;
      color: var(--muted);
      background: #090a0e;
      font-size: 14px;
    }

    .status-dot {
      width: 9px;
      height: 9px;
      border-radius: 50%;
      background: #777983;
    }

    .status.is-live {
      color: #c8f6df;
      border-color: #286647;
    }

    .status.is-live .status-dot {
      background: var(--green);
      box-shadow: 0 0 12px #5ed49a99;
    }

    .panel { padding: 26px; }

    .actions {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 12px;
      margin-bottom: 24px;
    }

    .action {
      display: flex;
      min-height: 76px;
      align-items: center;
      justify-content: center;
      gap: 10px;
      padding: 14px 12px;
      border: 1px solid #353740;
      border-radius: 18px;
      background: #0a0b0f;
      color: var(--text);
      text-decoration: none;
      cursor: pointer;
      transition: transform .18s ease, border-color .18s ease,
                  background .18s ease, box-shadow .18s ease;
    }

    .action:hover:not(:disabled) {
      transform: translateY(-2px);
      border-color: var(--gold);
      background: #17140f;
      box-shadow: 0 8px 24px #d99b3022;
    }

    .action:active:not(:disabled) { transform: translateY(0) scale(.98); }

    .action:focus-visible {
      outline: 2px solid var(--gold-light);
      outline-offset: 3px;
    }

    .action:disabled {
      opacity: .48;
      cursor: not-allowed;
    }

    .action svg {
      width: 22px;
      height: 22px;
      flex: 0 0 auto;
      color: var(--gold);
    }

    .action-primary {
      border-color: #e8b650;
      background: linear-gradient(180deg, var(--gold-light), #d49328);
      color: #171006;
      font-weight: 700;
    }

    .action-primary svg { color: #171006; }

    .action-primary:hover:not(:disabled) {
      border-color: #ffe3a2;
      background: linear-gradient(180deg, #ffe6aa, #e3a83f);
    }

    .viewer {
      overflow: hidden;
      border: 1px solid #30323a;
      border-radius: 24px;
      background: #050609;
    }

    .viewer-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 18px 20px;
      border-bottom: 1px solid #282a31;
    }

    .viewer-title {
      margin: 0;
      font-size: 19px;
    }

    .video-wrap {
      position: relative;
      aspect-ratio: 16 / 9;
      display: grid;
      place-items: center;
      background:
        radial-gradient(ellipse at center, #17130d, transparent 58%),
        #050609;
    }

    .video-wrap iframe {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      border: 0;
    }

    .empty-state {
      padding: 24px;
      text-align: center;
      color: var(--muted);
      line-height: 1.8;
    }

    .empty-state svg {
      display: block;
      width: 48px;
      height: 48px;
      margin: 0 auto 12px;
      color: var(--gold);
    }

    .hint {
      padding: 16px 4px 0;
      font-size: 14px;
    }

    @media (max-width: 760px) {
      body { padding: 18px 12px; }
      .header { align-items: flex-start; flex-direction: column; padding: 22px; }
      .panel { padding: 16px; border-radius: 24px; }
      .actions { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .action:last-child { grid-column: 1 / -1; }
    }

    @media (max-width: 420px) {
      .actions { grid-template-columns: 1fr; }
      .action:last-child { grid-column: auto; }
      .viewer-top { align-items: flex-start; flex-direction: column; }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        scroll-behavior: auto !important;
        transition-duration: .01ms !important;
      }
    }
  </style>
</head>

